<%# Ruby's own complexities — the thing people guess wrong about most often, and
    the reason a Ruby answer can differ from the Python one an interviewer expects. %>
<details class="rounded-lg border border-dashed border-line px-3.5 py-2.5 dark:border-night-line">
  <summary class="flex cursor-pointer items-center gap-2.5 text-[13px] font-medium select-none">
    <svg class="chevron size-3 shrink-0 text-ink-3 dark:text-mist-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"/></svg>
    Big-O of Ruby's own Array &amp; Hash
  </summary>
  <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 font-mono text-[11.5px] text-ink dark:text-mist sm:grid-cols-4">
    <% {
         "push / pop"     => "O(1)",
         "shift / unshift"=> "O(1)",
         "a[i]"           => "O(1)",
         "insert(i, x)"   => "O(n)",
         "include?"       => "O(n)",
         "sort"           => "O(n log n)",
         "h[k] / h[k]="   => "O(1)",
         "h.key?"         => "O(1)"
       }.each do |op, cost| %>
      <span class="flex justify-between gap-2 border-b border-dotted border-line-2 pb-0.5 dark:border-night-line"><%= op %> <span class="text-ink-3 dark:text-mist-3"><%= cost %></span></span>
    <% end %>
  </div>
  <p class="mt-3 max-w-prose text-[12px] leading-relaxed text-ink-2 dark:text-mist-2">
    <code class="rounded bg-paper-2 px-1 dark:bg-night-3">shift</code> is O(1) because CRuby moves the array's start pointer rather than
    re-indexing — worth saying out loud, since the same operation is O(n) on a Python list.
  </p>
</details>
