<details id="<%= category.slug %>" data-search-target="category" data-part="<%= category.part %>"
         class="group mb-2 scroll-mt-16 rounded-lg border bg-white/70 open:shadow-[0_1px_2px_rgb(0_0_0/0.04),0_8px_24px_-16px_rgb(0_0_0/0.12)] dark:bg-night-2/60 dark:open:shadow-none <%= category.todo? ? "border-dashed border-line dark:border-night-line" : "border-line dark:border-night-line" %>">
  <summary class="flex cursor-pointer items-center gap-2.5 px-3.5 py-2.5 select-none">
    <svg class="chevron size-3 shrink-0 text-ink-3 dark:text-mist-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"/></svg>
    <span class="text-[13px] <%= category.todo? ? "text-ink-3 dark:text-mist-3" : "font-medium" %>"><%= category.title %></span>
    <span class="flex-1"></span>
    <% if category.todo? %>
      <span class="rounded border border-line px-1.5 text-[10px] text-ink-3 dark:border-night-line dark:text-mist-3">todo</span>
    <% else %>
      <span class="font-mono text-[11px] tabular-nums text-ink-3 dark:text-mist-3"><%= category.snippets.size %></span>
    <% end %>
  </summary>

  <div class="border-t border-line-2 px-3.5 pt-3 pb-4 dark:border-night-line">
    <% if category.blurb %>
      <p class="mb-4 max-w-prose text-[12.5px] leading-relaxed text-ink-2 dark:text-mist-2"><%= inline_code(category.blurb) %></p>
    <% end %>
    <div class="divide-y divide-line-2 dark:divide-night-line">
      <% category.snippets.each do |snippet| %><%= render "snippet", snippet: snippet %><% end %>
    </div>
  </div>
</details>
